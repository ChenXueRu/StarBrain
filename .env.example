# 複製成 .env 後再修改；.env 不會被提交到 git

# 後端埠號
PORT=3700

# 資料存放位置，必須在專案資料夾以外；留空則使用「使用者家目錄/.starbrain」
STARBRAIN_DATA_DIR=

# 自動備份的資料夾，必須在專案資料夾以外；留空則使用「資料存放位置/backups」
# 想把備份同步到雲端，可以指到 Google Drive 電腦版的資料夾，例如 H:\我的雲端硬碟\StarBrain備份
STARBRAIN_BACKUP_DIR=

# 備份最多保留幾份，超過會刪掉最舊的；留空為 30，最少 1
STARBRAIN_BACKUP_KEEP=
